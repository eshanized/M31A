package(default_visibility = ["//visibility:public"])

# Linux platforms
platform(
    name = "linux_x86_64_gnu",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//bazel/platforms:gnu_libc",
    ],
)

platform(
    name = "linux_x86_64_musl",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//bazel/platforms:musl_libc",
    ],
)

# macOS platforms
platform(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

platform(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

# Windows platforms
platform(
    name = "windows_x86_64_msvc",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "//bazel/platforms:msvc_runtime",
    ],
)

platform(
    name = "windows_x86_64_gnullvm",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
        "//bazel/platforms:gnullvm_runtime",
    ],
)

# Constraint settings for libc/runtime selection
constraint_setting(name = "libc")
constraint_setting(name = "runtime")

constraint_value(name = "gnu_libc", constraint_setting = ":libc")
constraint_value(name = "musl_libc", constraint_setting = ":libc")

constraint_value(name = "msvc_runtime", constraint_setting = ":runtime")
constraint_value(name = "gnullvm_runtime", constraint_setting = ":runtime")

# Toolchain configuration for cross-compilation
toolchain_type(name = "rust_toolchain_type")