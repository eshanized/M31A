# M31A Bazel Build Targets
# NOTE: These targets wrap the local host Cargo environment (`cargo build`, `cargo test`)
# using non-hermetic local execution (`no-sandbox`, `local: 1`).

load("//bazel/rules:m31a_rules.bzl", "m31a_binary", "m31a_release_archive", "m31a_schema_bundle", "m31a_e2e_benchmark", "m31a_test")

package(default_visibility = ["//visibility:public"])

# Main CLI Binary Target
m31a_binary(
    name = "m31a",
    version = "0.1.13",
)

# Multi-Platform Release Archive Target
m31a_release_archive(
    name = "m31a_release",
    binary = ":m31a",
    version = "0.1.13",
)

# Workspace Verification Test
m31a_test(
    name = "workspace_test",
    tags = ["local", "no-sandbox"],
)

# Full Session E2E Benchmark Target
m31a_e2e_benchmark(
    name = "bench_full_session",
    iterations = 5,
)

# Protocol Schema Bundle Target
m31a_schema_bundle(
    name = "app_server_protocol_schema",
    proto_sources = glob(["crates/m31a-app-server/src/protocol/**/*.proto"], allow_empty = True),
    output_dir = "schemas/app_server",
)
