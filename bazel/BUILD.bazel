load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test", "rust_proc_macro")
load("@rules_rust//cargo:cargo.bzl", "cargo_crate")

# M31A Core Library
rust_library(
    name = "m31a_core",
    edition = "2024",
    crate_root = "crates/m31a-core/src/lib.rs",
    srcs = glob(["crates/m31a-core/src/**/*.rs"]),
    deps = [
        "@rules_rust//cargo/crate:serde",
        "@rules_rust//cargo/crate:serde_json",
        "@rules_rust//cargo/crate:tokio",
        "@rules_rust//cargo/crate:anyhow",
        "@rules_rust//cargo/crate:thiserror",
        "@rules_rust//cargo/crate:tracing",
        "@rules_rust//cargo/crate:clap",
        "@rules_rust//cargo/crate:uuid",
        "@rules_rust//cargo/crate:chrono",
        "@rules_rust//cargo/crate:toml",
        "@rules_rust//cargo/crate:directories",
        "@rules_rust//cargo/crate:regex",
        "@rules_rust//cargo/crate:semver",
    ],
)

# M31A Provider Library
